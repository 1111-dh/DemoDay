{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoday.local/contracts/capture.schema.json",
  "title": "Capture",
  "description": "B(캡처) → A(장면 생성). 단계별 실제 화면 스크린샷과 클릭 좌표. image 경로는 run 디렉터리 기준 상대경로.",
  "type": "object",
  "additionalProperties": false,
  "required": ["viewport", "shots"],
  "properties": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "shots": {
      "type": "array",
      "items": { "$ref": "#/$defs/Shot" }
    },
    "video": {
      "type": "string",
      "description": "세션 녹화 파일, run 디렉터리 기준 상대경로 (예: capture.webm). 녹화 실패 시 생략. 로그인 과정은 들어가지 않는다"
    },
    "login": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images"],
      "description": "로그인 장면용 정지 화면 (입력칸을 가린 상태). 없으면 로그인 장면 없이 간다",
      "properties": {
        "images": { "type": "array", "items": { "type": "string" }, "description": "예: shots/login-1.png (run 디렉터리 기준)" }
      }
    }
  },
  "$defs": {
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "Clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMs", "endMs"],
      "properties": {
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 }
      }
    },
    "Shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "image", "click"],
      "properties": {
        "stepId": { "type": "integer", "minimum": 1 },
        "image": { "type": "string", "description": "예: shots/2.png (run 디렉터리 기준)" },
        "click": {
          "description": "클릭 좌표(뷰포트 px). 클릭이 없는 단계는 null",
          "anyOf": [{ "$ref": "#/$defs/Point" }, { "type": "null" }]
        },
        "status": {
          "type": "string",
          "enum": ["ok", "fallback"],
          "default": "ok",
          "description": "fallback = 셀렉터를 못 찾아 정적 스크린샷으로 대체한 단계"
        },
        "atMs": { "type": "integer", "minimum": 0, "description": "캡처 시작 기준 화면 전환 시점(ms)" },
        "clip": { "$ref": "#/$defs/Clip", "description": "이 단계가 video에서 차지하는 구간(녹화 시작 기준 ms). 동작 시작 ~ 화면 안정 직후" }
      }
    }
  }
}
