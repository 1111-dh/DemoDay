{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoday.local/contracts/scenario.schema.json",
  "title": "Scenario",
  "description": "A(분석) → B(캡처). 헤드리스 브라우저가 따라갈 시연 단계 목록.",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseUrl", "steps"],
  "properties": {
    "baseUrl": { "type": "string", "format": "uri", "description": "배포 URL" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Step" }
    }
  },
  "$defs": {
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "caption"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "enum": ["goto", "click", "type", "scroll", "wait"] },
        "path": { "type": "string", "description": "goto일 때 baseUrl 기준 경로. 예: /search" },
        "selector": { "type": "string", "description": "Playwright selector. 예: text=검색, input[name=q]" },
        "value": { "type": "string", "description": "type일 때 입력값" },
        "caption": { "type": "string", "description": "장면 자막 초안" }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "goto" } } }, "then": { "required": ["path"] } },
        { "if": { "properties": { "action": { "const": "click" } } }, "then": { "required": ["selector"] } },
        { "if": { "properties": { "action": { "const": "type" } } }, "then": { "required": ["selector", "value"] } }
      ]
    }
  }
}
