{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoday.local/contracts/scene.schema.json",
  "title": "SceneDoc",
  "description": "A(장면 생성) → B(렌더링), C(미리보기·수정). LLM은 영상이 아니라 이 JSON만 만든다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fps", "totalSec", "scenes"],
  "properties": {
    "fps": { "type": "integer", "enum": [24, 30, 60] },
    "totalSec": { "type": "number", "exclusiveMinimum": 0, "description": "목표 발표 시간(초). 렌더 시 장면 길이를 이 비율로 맞춘다" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/TitleScene" },
          { "$ref": "#/$defs/ScreenScene" },
          { "$ref": "#/$defs/ArchitectureScene" },
          { "$ref": "#/$defs/PointsScene" }
        ]
      }
    }
  },
  "$defs": {
    "Transition": { "type": "string", "enum": ["none", "fade", "slide"], "default": "fade" },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "Icon": {
      "type": "string",
      "enum": ["clock", "alert", "search", "document", "chart", "user", "team", "check", "bolt", "money", "chat", "calendar", "map", "store", "ai"]
    },
    "PointItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "text"],
      "properties": {
        "icon": { "$ref": "#/$defs/Icon" },
        "text": { "type": "string", "description": "24자 이내 한 줄" }
      }
    },
    "PointsScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationSec", "heading", "items"],
      "description": "소개 그래픽 — 문제(불편 2~3개)·해결(핵심 기능 3개)을 아이콘 카드로",
      "properties": {
        "type": { "const": "points" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "transition": { "$ref": "#/$defs/Transition" },
        "kicker": { "type": "string", "description": "\"문제\" | \"해결\" 등 — 톤을 나눈다" },
        "heading": { "type": "string", "description": "한 줄 제목 (28자 이내)" },
        "items": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/PointItem" } }
      }
    },
    "VideoClip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "startMs", "endMs"],
      "description": "있으면 이 구간을 재생하고, image는 대체 화면(poster)으로 쓴다",
      "properties": {
        "src": { "type": "string", "description": "run 디렉터리 기준. 예: capture.webm" },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 }
      }
    },
    "Zoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "scale"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "type": "number", "minimum": 1, "maximum": 4 }
      }
    },
    "TitleScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationSec", "text"],
      "properties": {
        "type": { "const": "title" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "transition": { "$ref": "#/$defs/Transition" },
        "text": { "type": "string" },
        "subtitle": { "type": "string" },
        "kicker": { "type": "string", "description": "제목 위 작은 라벨 (예: \"01\", \"문제\"). 있으면 장 구분 카드로 그린다" }
      }
    },
    "ScreenScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationSec", "image"],
      "properties": {
        "type": { "const": "screen" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "transition": { "$ref": "#/$defs/Transition" },
        "image": { "type": "string", "description": "run 디렉터리 기준 상대경로. 예: shots/2.png" },
        "zoom": { "$ref": "#/$defs/Zoom" },
        "cursor": { "$ref": "#/$defs/Point" },
        "caption": { "type": "string" },
        "highlight": { "type": "array", "items": { "type": "string" }, "description": "caption 안에서 강조할 단어" },
        "video": { "$ref": "#/$defs/VideoClip" }
      }
    },
    "ArchitectureScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationSec", "nodes", "edges"],
      "properties": {
        "type": { "const": "architecture" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "transition": { "$ref": "#/$defs/Transition" },
        "nodes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "edges": {
          "type": "array",
          "description": "[from, to] — nodes 배열 인덱스",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  }
}
